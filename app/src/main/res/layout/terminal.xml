<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminalBackground">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#333333">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/content_dismiss"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Back"
            app:tint="@color/terminalText" />

        <TextView
            android:id="@+id/terminal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/terminal"
            android:textColor="@color/terminalText"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/terminal_clear"
            android:textSize="11sp"
            android:textColor="@color/terminalText"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- Terminal Output -->
    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:fillViewport="true">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/terminalText"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#333333">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/terminal_prompt"
            android:textColor="@color/terminalText"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/terminal_input"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:hint="@string/terminal_hint"
            android:textColor="@color/terminalText"
            android:textColorHint="#555555"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:background="#222222"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:imeOptions="actionSend"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_run"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/terminal_run"
            android:textSize="12sp"
            android:textColor="@color/terminalBackground"
            android:backgroundTint="@color/terminalText"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>
</LinearLayout>
