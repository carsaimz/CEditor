<string name="welcome_title">Bem-vindo ao CEditor</string>
<string name="welcome_subtitle">Seu poderoso editor de código</string>
<string name="welcome_intro_en">CEditor is a modern code editor for Android. Here\'s how to get started:</string>
<string name="welcome_intro_pt">CEditor é um editor de código moderno para Android. Aqui está como começar:</string>
<string name="welcome_tip1_title">📁 Navegar Arquivos</string>
<string name="welcome_tip1_desc_en">Tap on files to open them in the editor. Supports Java, Kotlin, HTML, CSS, JS, Python, PHP, and more.</string>
<string name="welcome_tip1_desc_pt">Toque nos arquivos para abri-los no editor. Suporta Java, Kotlin, HTML, CSS, JS, Python, PHP e mais.</string>
<string name="welcome_tip2_title">🤖 Assistente IA</string>
<string name="welcome_tip2_desc_en">Configure AI providers in Settings to get code help, explanations, and generation.</string>
<string name="welcome_tip2_desc_pt">Configure provedores de IA nas Configurações para obter ajuda com código.</string>
<string name="welcome_tip3_title">🖥️ Terminal</string>
<string name="welcome_tip3_desc_en">Use the built-in terminal to run commands on your device.</string>
<string name="welcome_tip3_desc_pt">Use o terminal integrado para executar comandos no seu dispositivo.</string>
<string name="welcome_tip4_title">👁️ Pré-visualizar</string>
<string name="welcome_tip4_desc_en">Preview HTML, CSS, JS, and Markdown files directly in the app.</string>
<string name="welcome_tip4_desc_pt">Visualize arquivos HTML, CSS, JS e Markdown diretamente no app.</string>
